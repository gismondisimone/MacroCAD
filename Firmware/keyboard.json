{
    "manufacturer": "Simone",
    "keyboard_name": "macrocad",
    "maintainer": "gismondisimone",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "oled": true
    },
    "i2c": {
        "sda_pin": "GP5",
        "scl_pin": "GP6"
    },
     "oled": {
          "driver": "SSD1306",
          "display": {
              "width": 128,
              "height": 32
         }
    },
    "matrix_pins": {
        "cols": ["GP9", "GP10", "GP11"],
        "rows": ["GP1", "GP2", "GP3", "GP4"]
    },
    "processor": "RP2040",
    "url": "https://github.com/gismondisimone/MacroCAD",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2},
                {"matrix": [3, 0], "x": 0, "y": 3},
                {"matrix": [3, 1], "x": 1, "y": 3},
                {"matrix": [3, 2], "x": 2, "y": 3}
            ]
        }
    }
}